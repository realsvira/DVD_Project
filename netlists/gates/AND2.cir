* AND2 transistor-level leakage reference, inputs AB=00
* Technology 45nm_HP, L = 45 nm; corner 0: VDD=1.06067 V, T=76.8406 C
* Devices: mpa(pmos, W=180n, d=n1 g=a s=vdd b=vdd), mpb(pmos, W=180n, d=n1 g=b s=vdd b=vdd), mna(nmos, W=180n, d=n1 g=a s=x b=0), mnb(nmos, W=180n, d=x g=b s=0 b=0), mpi(pmos, W=180n, d=out g=n1 s=vdd b=vdd), mni(nmos, W=90n, d=out g=n1 s=0 b=0)
* Leakage: I_leak = sum_k V_k * (-i(V_k)) / VDD over the sources Vdd, Va, Vb
* Probe sign: current INTO device terminal = +i(V<dev>_<t>)
.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.temp 76.840581613
Vdd vdd 0 dc 1.06066688601
Va a 0 dc 0
Vb b 0 dc 0
* devices; each terminal reaches its node through a 0 V current probe
Mmpa mpa_d mpa_g mpa_s mpa_b pmos W=1.8e-07 L=4.5e-08
VMPA_D n1 mpa_d dc 0
VMPA_G a mpa_g dc 0
VMPA_S vdd mpa_s dc 0
VMPA_B vdd mpa_b dc 0
Mmpb mpb_d mpb_g mpb_s mpb_b pmos W=1.8e-07 L=4.5e-08
VMPB_D n1 mpb_d dc 0
VMPB_G b mpb_g dc 0
VMPB_S vdd mpb_s dc 0
VMPB_B vdd mpb_b dc 0
Mmna mna_d mna_g mna_s mna_b nmos W=1.8e-07 L=4.5e-08
VMNA_D n1 mna_d dc 0
VMNA_G a mna_g dc 0
VMNA_S x mna_s dc 0
VMNA_B 0 mna_b dc 0
Mmnb mnb_d mnb_g mnb_s mnb_b nmos W=1.8e-07 L=4.5e-08
VMNB_D x mnb_d dc 0
VMNB_G b mnb_g dc 0
VMNB_S 0 mnb_s dc 0
VMNB_B 0 mnb_b dc 0
Mmpi mpi_d mpi_g mpi_s mpi_b pmos W=1.8e-07 L=4.5e-08
VMPI_D out mpi_d dc 0
VMPI_G n1 mpi_g dc 0
VMPI_S vdd mpi_s dc 0
VMPI_B vdd mpi_b dc 0
Mmni mni_d mni_g mni_s mni_b nmos W=9e-08 L=4.5e-08
VMNI_D out mni_d dc 0
VMNI_G n1 mni_g dc 0
VMNI_S 0 mni_s dc 0
VMNI_B 0 mni_b dc 0
